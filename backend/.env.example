FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# If you are NOT using Supabase Auth, you can ignore issuer.
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1

# Backend DB access (recommended): service role key
# Keep this server-only.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# App JWT secret (used for our own login tokens)
APP_JWT_SECRET=change-me
